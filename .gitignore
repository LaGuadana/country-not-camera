# environment and caches
.venv/
__pycache__/
*.pyc

# raw and derived data (3 GB; regenerated by scripts/ — see README). The subset's manifest (ids, splits,
# labels, metadata; no images) is tracked because the end-to-end runs' training split cannot be
# re-drawn bit-identically on another platform without it (scripts/restore_manifest.py).
data/*
!data/c32/
data/c32/*
!data/c32/manifest.csv
!data/c32/classes.json
!data/c32/subset_stats.json

# kaggle staging bundles
dist/

# model checkpoints and per-split feature exports (35-45 MB each; regenerate by training
# or `evaluate.py --features`). metrics, predictions and analysis JSONs in runs/ ARE tracked.
runs/**/*.pt
!runs/stage_3/best.pt
!runs/ft_imagenet/best.pt
!runs/ft_imagenet_fp/best.pt
runs/**/features_*.npz
runs/**/logits_*.npz

# the assignment brief is course material, not ours to redistribute
project_ML_commskills_2026(1).pdf

# latex build intermediates
*.aux
*.out
*.bbl
*.blg
*.synctex.gz
